{
  "name": "dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc --noEmit",
    "check:boundary": "node scripts/check-library-boundary.mjs",
    "check:legacy": "node scripts/check-legacy-thin.mjs",
    "check:docs": "node scripts/check-docs-routes.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run check:boundary && npm run check:legacy && npm run check:docs && npm run lint && npm run test:coverage && npm run build"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "vue-router": {
      "optional": true
    }
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@tiptap/extension-placeholder": "^3.4.5",
    "@tiptap/starter-kit": "^3.4.5",
    "@tiptap/vue-3": "^3.4.5",
    "@tracespace/parser": "5.0.0-alpha.0",
    "@tracespace/plotter": "^5.0.0-alpha.0",
    "@vuepic/vue-datepicker": "^11.0.2",
    "@vueuse/core": "^13.6.0",
    "axios": "^1.10.0",
    "d3": "^7.9.0",
    "express": "^4.18.2",
    "lodash": "^4.17.21",
    "material-symbols": "^0.40.2",
    "pinia": "^3.0.3",
    "plotly.js-dist-min": "^3.5.0",
    "vue": "^3.5.0",
    "vue-router": "^4.0.0",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^2.1.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^16.5.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.6",
    "postcss-import": "^17.0.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.4.19",
    "vitest": "^2.1.9",
    "vue-tsc": "^3.2.6",
    "ws": "^8.18.3"
  }
}
